<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>PartyHub</title>
<meta name="theme-color" content="#818cf8">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#818cf8">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="PartyHub">
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Crect width='512' height='512' rx='110' fill='%23818cf8'/%3E%3Ctext x='50%25' y='56%25' font-size='300' text-anchor='middle' dominant-baseline='middle' font-family='system-ui'%3EPH%3C/text%3E%3C/svg%3E">
<link rel="manifest" href="manifest.json">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<style>
/* ============ THEME TOKENS ============ */
:root{
  --r-lg:28px; --r-md:20px; --r-sm:14px;
  --g-fr:linear-gradient(135deg,#fb7185,#f97316);
  --g-im:linear-gradient(135deg,#a78bfa,#6366f1);
  --g-ki:linear-gradient(135deg,#fbbf24,#f59e0b);
  --g-td:linear-gradient(135deg,#22d3ee,#3b82f6);
  --g-main:linear-gradient(135deg,#818cf8,#c084fc,#f472b6);
  --danger:linear-gradient(135deg,#ef4444,#b91c1c);
}
html[data-theme="light"]{
  --bg:#eef1fb; --text:#22283d; --text-soft:rgba(34,40,61,.6);
  --glass:rgba(255,255,255,.55); --glass-hi:rgba(255,255,255,.78);
  --stroke:rgba(255,255,255,.75); --stroke-soft:rgba(34,40,61,.10);
  --shadow:0 10px 34px rgba(49,58,110,.16);
  --blob1:rgba(165,180,252,.72); --blob2:rgba(249,168,212,.62); --blob3:rgba(103,232,249,.58);
  --input-bg:rgba(255,255,255,.65); --chip:rgba(255,255,255,.68);
  --doodle:rgba(34,40,61,.85); --doodle-soft:rgba(34,40,61,.28);
}
html[data-theme="dark"]{
  --bg:#0d1022; --text:#e9ebf7; --text-soft:rgba(233,235,247,.62);
  --glass:rgba(255,255,255,.07); --glass-hi:rgba(255,255,255,.12);
  --stroke:rgba(255,255,255,.14); --stroke-soft:rgba(255,255,255,.10);
  --shadow:0 12px 38px rgba(0,0,0,.45);
  --blob1:rgba(99,102,241,.44); --blob2:rgba(219,39,119,.32); --blob3:rgba(14,165,233,.3);
  --input-bg:rgba(255,255,255,.08); --chip:rgba(255,255,255,.10);
  --doodle:rgba(233,235,247,.9); --doodle-soft:rgba(233,235,247,.3);
}
/* ============ BASE ============ */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  font-family:'Quicksand',sans-serif;color:var(--text);background:var(--bg);
  min-height:100vh;transition:background .4s ease,color .4s ease;overflow-x:hidden;
}
.blob{position:fixed;border-radius:50%;filter:blur(70px);z-index:-2;pointer-events:none;transition:background .5s ease;}
.b1{width:52vmax;height:52vmax;top:-18vmax;left:-14vmax;background:var(--blob1);animation:drift1 26s ease-in-out infinite alternate;}
.b2{width:44vmax;height:44vmax;bottom:-16vmax;right:-12vmax;background:var(--blob2);animation:drift2 32s ease-in-out infinite alternate;}
.b3{width:34vmax;height:34vmax;top:38%;left:55%;background:var(--blob3);animation:drift3 38s ease-in-out infinite alternate;}
@keyframes drift1{to{transform:translate(9vmax,7vmax) scale(1.12)}}
@keyframes drift2{to{transform:translate(-8vmax,-6vmax) scale(1.08)}}
@keyframes drift3{to{transform:translate(-10vmax,6vmax) scale(.92)}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* doodle sprinkles fijos en el fondo */
.sprinkle{position:fixed;z-index:-1;color:var(--doodle-soft);pointer-events:none;
  animation:bob 6s ease-in-out infinite alternate;}
.sprinkle svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;}
@keyframes bob{from{transform:translateY(0) rotate(-4deg)}to{transform:translateY(10px) rotate(5deg)}}

.app{max-width:560px;margin:0 auto;padding:22px 18px 70px;position:relative;}
h1,h2,h3{font-family:'Baloo 2',cursive;margin:0;}
.screen{display:none;animation:rise .32s ease;}
.screen.active{display:block;}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* ============ GLASS PRIMITIVES ============ */
.glass{
  background:var(--glass);border:1px solid var(--stroke);border-radius:var(--r-lg);
  box-shadow:var(--shadow);backdrop-filter:blur(20px) saturate(1.5);
  -webkit-backdrop-filter:blur(20px) saturate(1.5);padding:20px 22px;position:relative;
}
.stack{display:flex;flex-direction:column;gap:16px;}
.row{display:flex;gap:12px;} .row>*{flex:1;}
.center{text-align:center;}
.hint{font-size:.92rem;color:var(--text-soft);line-height:1.55;margin:6px 0 0;font-weight:500;}
.title{font-size:1.4rem;font-weight:700;letter-spacing:-.01em;}
.eyebrow{font-family:'Baloo 2',cursive;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text-soft);}

.btn{
  font-family:'Baloo 2',cursive;font-weight:700;font-size:1.02rem;color:var(--text);
  background:var(--glass-hi);border:1px solid var(--stroke);border-radius:var(--r-md);
  padding:14px 18px;cursor:pointer;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  box-shadow:var(--shadow);transition:transform .12s ease,filter .12s ease;text-align:center;
}
.btn:hover{filter:brightness(1.04)} .btn:active{transform:scale(.96) rotate(-.6deg);}
.btn:focus-visible{outline:2px solid #818cf8;outline-offset:2px;}
.btn.primary{background:var(--g-main);color:#fff;border:none;text-shadow:0 1px 2px rgba(0,0,0,.18);}
.btn.grad-fr{background:var(--g-fr);color:#fff;border:none;text-shadow:0 1px 2px rgba(0,0,0,.18);}
.btn.grad-im{background:var(--g-im);color:#fff;border:none;text-shadow:0 1px 2px rgba(0,0,0,.18);}
.btn.grad-ki{background:var(--g-ki);color:#fff;border:none;text-shadow:0 1px 2px rgba(0,0,0,.18);}
.btn.grad-td{background:var(--g-td);color:#fff;border:none;text-shadow:0 1px 2px rgba(0,0,0,.18);}
.btn.danger{background:var(--danger);color:#fff;border:none;}
.btn.quiet{background:transparent;border:1.5px dashed var(--stroke-soft);box-shadow:none;font-size:.95rem;color:var(--text-soft);}
.btn.big{font-size:1.12rem;padding:16px 20px;width:100%;}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none;}
.icon{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;vertical-align:-5px;}

.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:10px;}
.back{display:inline-flex;align-items:center;gap:6px;font-family:'Baloo 2',cursive;font-weight:700;
  font-size:.92rem;color:var(--text);background:var(--glass-hi);border:1px solid var(--stroke);
  border-radius:999px;padding:9px 16px;cursor:pointer;backdrop-filter:blur(12px);box-shadow:var(--shadow);}
.back:active{transform:scale(.96)}
.gametag{font-family:'Baloo 2',cursive;font-weight:700;font-size:.84rem;letter-spacing:.05em;
  text-transform:uppercase;padding:8px 16px;border-radius:999px;color:#fff;transform:rotate(2deg);}
.gametag.fr{background:var(--g-fr)} .gametag.im{background:var(--g-im)}
.gametag.ki{background:var(--g-ki)} .gametag.td{background:var(--g-td)}

input[type=text]{
  font-family:'Quicksand',sans-serif;font-weight:600;font-size:1rem;color:var(--text);width:100%;
  background:var(--input-bg);border:1.5px solid var(--stroke-soft);border-radius:var(--r-sm);
  padding:12px 14px;outline:none;transition:border .15s ease;
}
input[type=text]::placeholder{color:var(--text-soft);font-weight:500;}
input[type=text]:focus{border-color:#818cf8;}

/* checklist pills */
.checks{display:flex;flex-wrap:wrap;gap:10px;}
.checkpill{display:inline-flex;align-items:center;gap:8px;font-family:'Baloo 2',cursive;font-weight:700;
  font-size:.9rem;color:var(--text);background:var(--glass-hi);border:1px solid var(--stroke);
  border-radius:999px;padding:9px 15px;cursor:pointer;transition:all .15s ease;user-select:none;}
.checkpill .box{width:17px;height:17px;border-radius:6px;border:1.7px solid var(--text-soft);
  display:inline-flex;align-items:center;justify-content:center;transition:all .15s ease;flex:none;}
.checkpill .box svg{width:11px;height:11px;stroke:#fff;stroke-width:3;fill:none;opacity:0;}
.checkpill.on{border-color:transparent;box-shadow:0 4px 14px rgba(99,102,241,.28);transform:rotate(-1deg);}
.checkpill.on .box{background:var(--g-main);border-color:transparent;}
.checkpill.on .box svg{opacity:1;}

/* switch */
.switch{position:relative;width:52px;height:30px;flex:none;cursor:pointer;}
.switch input{opacity:0;width:100%;height:100%;position:absolute;margin:0;cursor:pointer;}
.switch .track{position:absolute;inset:0;border-radius:999px;background:var(--chip);border:1px solid var(--stroke-soft);transition:background .2s ease;}
.switch .knob{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.25);transition:transform .2s ease;}
.switch input:checked + .track{background:var(--g-main);border-color:transparent;}
.switch input:checked ~ .knob{transform:translateX(22px);}

/* segmented */
.seg{display:flex;background:var(--chip);border:1px solid var(--stroke-soft);border-radius:999px;padding:4px;gap:4px;}
.seg button{flex:1;font-family:'Baloo 2',cursive;font-weight:700;font-size:.92rem;color:var(--text-soft);
  background:transparent;border:none;border-radius:999px;padding:9px 6px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:7px;transition:all .18s ease;}
.seg button.on{background:var(--g-main);color:#fff;box-shadow:0 4px 12px rgba(99,102,241,.3);}

/* stepper */
.stepper{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.stepper .lbl{font-family:'Baloo 2',cursive;font-weight:700;}
.stepper .ctrl{display:flex;align-items:center;gap:14px;}
.stepper .val{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.5rem;min-width:34px;text-align:center;}
.stepbtn{width:42px;height:42px;border-radius:15px;font-size:1.3rem;font-weight:800;color:var(--text);
  background:var(--glass-hi);border:1px solid var(--stroke);cursor:pointer;box-shadow:var(--shadow);
  font-family:'Baloo 2',cursive;}
.stepbtn:active{transform:scale(.92)}

/* ============ AVATARES DOODLE ============ */
.av{width:38px;height:38px;color:var(--doodle);flex:none;}
.av use, .av{stroke-linecap:round;stroke-linejoin:round;}
.av.sm{width:28px;height:28px;}
.av.lg{width:96px;height:96px;}
.av.md{width:58px;height:58px;}
.av-wrap{display:inline-flex;align-items:center;justify-content:center;background:var(--chip);
  border:1.5px solid var(--stroke-soft);border-radius:50%;padding:6px;}

/* mascota del hero */
.mascot{width:86px;height:86px;color:var(--doodle);flex:none;animation:mascotbob 4s ease-in-out infinite alternate;}
@keyframes mascotbob{from{transform:translateY(0) rotate(-3deg)}to{transform:translateY(-8px) rotate(4deg)}}
.corner-doodle{position:absolute;color:var(--doodle-soft);pointer-events:none;}
.corner-doodle svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;}

/* ============ HOME ============ */
.hero{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:6px 0 22px;}
.hero h1{font-size:clamp(2.4rem,9vw,3.1rem);font-weight:800;letter-spacing:-.03em;line-height:1;
  background:var(--g-main);-webkit-background-clip:text;background-clip:text;color:transparent;transform:rotate(-1.5deg);}
.hero p{margin:8px 0 0;color:var(--text-soft);font-size:.95rem;max-width:28ch;font-weight:600;}
.iconbtn{width:46px;height:46px;border-radius:16px;display:flex;align-items:center;justify-content:center;
  background:var(--glass-hi);border:1px solid var(--stroke);cursor:pointer;color:var(--text);
  box-shadow:var(--shadow);backdrop-filter:blur(12px);flex:none;}
.iconbtn:active{transform:scale(.92) rotate(-8deg)}

.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px;}
.chip{display:inline-flex;align-items:center;gap:7px;background:var(--chip);border:1.5px solid var(--stroke-soft);
  border-radius:999px;padding:5px 9px 5px 6px;font-size:.9rem;font-weight:700;}
.chip button{width:22px;height:22px;border-radius:50%;border:none;background:rgba(128,128,160,.18);
  color:var(--text-soft);cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none;}
.chip button:hover{background:rgba(239,68,68,.2);color:#ef4444;}
.addrow{display:flex;gap:10px;margin-top:12px;}
.addrow input{flex:1;}
.addrow .btn{flex:none;padding:12px 18px;}
.empty-note{font-size:.9rem;color:var(--text-soft);margin-top:10px;font-weight:600;}

.game-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px;}
.game-card{position:relative;border-radius:var(--r-lg);padding:20px 16px 18px;cursor:pointer;color:var(--text);
  background:var(--glass);border:1px solid var(--stroke);box-shadow:var(--shadow);
  backdrop-filter:blur(20px) saturate(1.5);-webkit-backdrop-filter:blur(20px) saturate(1.5);
  transition:transform .15s ease;overflow:hidden;text-align:left;font-family:'Quicksand',sans-serif;}
.game-card:hover{transform:translateY(-3px) rotate(-.5deg);}
.game-card:active{transform:scale(.96);}
.game-card::after{content:"";position:absolute;inset:0 0 auto 0;height:5px;}
.game-card.fr::after{background:var(--g-fr)} .game-card.im::after{background:var(--g-im)}
.game-card.ki::after{background:var(--g-ki)} .game-card.td::after{background:var(--g-td)}
.gicon{width:48px;height:48px;border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff;margin-bottom:12px;transform:rotate(-4deg);}
.game-card.fr .gicon{background:var(--g-fr)} .game-card.im .gicon{background:var(--g-im)}
.game-card.ki .gicon{background:var(--g-ki)} .game-card.td .gicon{background:var(--g-td)}
.game-card h3{font-size:1.12rem;font-weight:700;}
.game-card p{margin:5px 0 0;font-size:.8rem;color:var(--text-soft);line-height:1.45;font-weight:600;}
.card-doodle{position:absolute;top:10px;right:10px;width:26px;height:26px;color:var(--doodle-soft);}
.card-doodle svg{width:100%;height:100%;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round;}

/* ============ ROSTER ============ */
.rosterlist{display:flex;flex-direction:column;gap:10px;margin-top:6px;}
.rosterrow{display:flex;align-items:center;gap:9px;}
.rosterrow input{flex:1;min-width:60px;}
.mini{width:38px;height:38px;border-radius:13px;border:1.5px solid var(--stroke-soft);background:var(--chip);
  color:var(--text-soft);cursor:pointer;display:flex;align-items:center;justify-content:center;flex:none;}
.mini:disabled{opacity:.3;cursor:default;}
.mini:not(:disabled):active{transform:scale(.9)}
.mini.del:hover{color:#ef4444;border-color:rgba(239,68,68,.4);}
.err{color:#ef4444;font-size:.9rem;font-weight:700;display:none;margin-top:6px;}
.err.show{display:block;}

/* ============ FRENESÍ ============ */
.scoreboard{display:flex;gap:14px;}
.score{flex:1;text-align:center;border-radius:var(--r-lg);padding:14px 10px;color:#fff;box-shadow:var(--shadow);}
.score .num{font-family:'Baloo 2',cursive;font-size:2.2rem;font-weight:800;display:block;line-height:1.1;}
.score .name{font-size:.86rem;font-weight:700;opacity:.94;word-break:break-word;}
.score.t0{background:var(--g-fr);transform:rotate(-1deg);} .score.t1{background:var(--g-td);transform:rotate(1deg);}
.pulse-wrap{display:flex;justify-content:center;padding:6px 0;}
.pulse{width:64px;height:64px;border-radius:50%;background:var(--g-fr);position:relative;
  animation:beat var(--beat,1.1s) ease-in-out infinite;}
.pulse::before{content:"";position:absolute;inset:-10px;border-radius:50%;border:2.5px solid rgba(251,113,133,.5);
  animation:ring var(--beat,1.1s) ease-out infinite;}
.pulse.paused, .pulse.paused::before{animation-play-state:paused;}
@keyframes beat{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}
@keyframes ring{from{transform:scale(.8);opacity:1}to{transform:scale(1.5);opacity:0}}
.bigword{font-family:'Baloo 2',cursive;font-weight:800;font-size:clamp(1.8rem,8vw,2.5rem);
  text-align:center;line-height:1.15;min-height:2.3em;display:flex;align-items:center;justify-content:center;letter-spacing:-.01em;}
#flash{position:fixed;inset:0;background:radial-gradient(circle at 50% 40%, rgba(239,68,68,.85), rgba(153,27,27,.95));
  z-index:80;display:none;align-items:center;justify-content:center;pointer-events:none;}
#flash.on{display:flex;animation:flashpulse .5s ease-in-out 3;}
#flash span{font-family:'Baloo 2',cursive;font-weight:800;font-size:clamp(3rem,15vw,5rem);color:#fff;letter-spacing:.04em;transform:rotate(-3deg);}
@keyframes flashpulse{0%,100%{opacity:1}50%{opacity:.55}}
.boomcard{background:var(--danger)!important;color:#fff;border:none!important;}
.boomcard .hint{color:rgba(255,255,255,.88);}
.win-doodle{display:flex;justify-content:center;color:var(--doodle);animation:winjump .7s ease infinite alternate;}
.win-doodle svg{width:110px;height:110px;}
@keyframes winjump{from{transform:translateY(0) rotate(-4deg)}to{transform:translateY(-12px) rotate(5deg)}}

/* confetti (rectangulos CSS, sin emojis) */
.cf{position:fixed;top:-24px;width:10px;height:16px;border-radius:3px;z-index:99;pointer-events:none;animation:cfall linear forwards;}
@keyframes cfall{to{transform:translateY(115vh) rotate(720deg);}}

/* ============ IMPOSTOR ============ */
.role-card{min-height:200px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:8px;cursor:pointer;text-align:center;}
.role-card.hiddenface{background:var(--g-im);border:none;color:#fff;}
.role-card.hiddenface .hint{color:rgba(255,255,255,.88);}
.secretword{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.9rem;letter-spacing:-.01em;}
.imp-label{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.6rem;color:#fb7185;}
.timerbig{font-family:'Baloo 2',cursive;font-weight:800;font-size:2.6rem;letter-spacing:.02em;}
.turnhead{display:flex;flex-direction:column;align-items:center;gap:8px;}

/* ============ REY DE COPAS ============ */
.rankgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
.rank{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.55rem;color:var(--text);
  background:var(--glass);border:1px solid var(--stroke);border-radius:var(--r-md);
  box-shadow:var(--shadow);padding:20px 4px;cursor:pointer;text-align:center;backdrop-filter:blur(16px);transition:transform .12s ease;}
.rank:nth-child(odd){transform:rotate(-1deg)} .rank:nth-child(even){transform:rotate(1deg)}
.rank:active{transform:scale(.9)}
.customrow{display:grid;grid-template-columns:44px 1fr;gap:10px;align-items:center;}
.customrow .rk{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.1rem;text-align:center;
  background:var(--g-ki);color:#fff;border-radius:13px;padding:10px 0;transform:rotate(-3deg);}
.overlay{position:fixed;inset:0;background:rgba(10,12,30,.5);backdrop-filter:blur(6px);
  display:none;align-items:center;justify-content:center;padding:20px;z-index:60;}
.overlay.open{display:flex;}
.overlay .glass{max-width:440px;width:100%;animation:rise .25s ease;max-height:88vh;overflow:auto;}
.orank{font-family:'Baloo 2',cursive;font-weight:800;font-size:2.6rem;
  background:var(--g-ki);-webkit-background-clip:text;background-clip:text;color:transparent;}

/* ============ VERDAD O RETO ============ */
.playerbtns{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.playerbtns .btn{padding:13px 10px;display:flex;align-items:center;gap:10px;justify-content:flex-start;}
.tdtag{display:inline-block;font-family:'Baloo 2',cursive;font-weight:700;font-size:.82rem;
  letter-spacing:.07em;text-transform:uppercase;color:#fff;border-radius:999px;padding:7px 16px;margin-bottom:8px;transform:rotate(-2deg);}
.tdtag.v{background:var(--g-td)} .tdtag.r{background:var(--g-fr)}
.customlist{display:flex;flex-direction:column;gap:8px;margin-top:10px;}
.customitem{display:flex;align-items:center;gap:8px;background:var(--chip);border:1.5px solid var(--stroke-soft);
  border-radius:var(--r-sm);padding:8px 10px;font-size:.9rem;font-weight:600;}
.customitem span{flex:1;}

.setrow{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:6px 0;}
.setrow b{font-family:'Baloo 2',cursive;font-weight:700;}
.footer-note{text-align:center;margin-top:34px;font-size:.8rem;color:var(--text-soft);font-weight:700;}

/* ============ HORIZONTAL / PANTALLAS ANCHAS ============ */
@media (min-width:720px){
  .app{max-width:940px;}
  .game-grid{grid-template-columns:repeat(4,1fr);}
  .playerbtns{grid-template-columns:repeat(3,1fr);}
  .rankgrid{grid-template-columns:repeat(7,1fr);}
}
@media (orientation:landscape) and (max-height:520px){
  .app{padding:12px 16px 40px;max-width:820px;}
  .hero{margin-bottom:12px;} .hero h1{font-size:2rem;} .mascot{width:60px;height:60px;}
  .glass{padding:14px 18px;}
  .stack{gap:10px;}
  .pulse{width:44px;height:44px;}
  .bigword{min-height:1.6em;font-size:clamp(1.5rem,5vw,2.1rem);}
  .btn.big{padding:12px 16px;}
  .game-grid{grid-template-columns:repeat(4,1fr);}
  .rankgrid{grid-template-columns:repeat(7,1fr);}
  .rank{padding:12px 4px;font-size:1.2rem;}
}

.av{stroke:currentColor;fill:none;}
.win-doodle svg{stroke:currentColor;fill:none;}
.mascot{stroke:currentColor;fill:none;}

/* ============ DOODLE DECOR ============ */
.doodles{position:fixed;inset:0;z-index:-1;pointer-events:none;color:var(--text);}
.doodles span{position:absolute;opacity:.14;animation:wiggle 5s ease-in-out infinite;}
html[data-theme="dark"] .doodles span{opacity:.2;}
.doodles svg{stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;}
@keyframes wiggle{0%,100%{transform:rotate(-8deg) translateY(0)}50%{transform:rotate(8deg) translateY(-6px)}}

body{padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom);
  padding-left:env(safe-area-inset-left);padding-right:env(safe-area-inset-right);}

/* ============ COLOR EN CONFIGURACION ============ */
.glass{position:relative;}
#scr-home .glass, #scr-roster .glass, #scr-fr-setup .glass, #scr-im-setup .glass,
#scr-ki-setup .glass, #scr-ki-custom .glass, #scr-td-level .glass, #scr-td-custom .glass{overflow:hidden;}
#scr-home .glass::before, #scr-roster .glass::before, #scr-fr-setup .glass::before, #scr-im-setup .glass::before,
#scr-ki-setup .glass::before, #scr-ki-custom .glass::before, #scr-td-level .glass::before, #scr-td-custom .glass::before{
  content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--g-main);opacity:.9;}
#scr-fr-setup .glass::before{background:var(--g-fr);}
#scr-im-setup .glass::before{background:var(--g-im);}
#scr-ki-setup .glass::before, #scr-ki-custom .glass::before{background:var(--g-ki);}
#scr-td-level .glass::before, #scr-td-custom .glass::before{background:var(--g-td);}
#scr-fr-setup .eyebrow{background:var(--g-fr);-webkit-background-clip:text;background-clip:text;color:transparent;}
#scr-im-setup .eyebrow{background:var(--g-im);-webkit-background-clip:text;background-clip:text;color:transparent;}
#scr-ki-setup .eyebrow, #scr-ki-custom .eyebrow{background:var(--g-ki);-webkit-background-clip:text;background-clip:text;color:transparent;}
#scr-td-level .eyebrow, #scr-td-custom .eyebrow{background:var(--g-td);-webkit-background-clip:text;background-clip:text;color:transparent;}
#scr-home .eyebrow{background:var(--g-main);-webkit-background-clip:text;background-clip:text;color:transparent;}
/* pills de categorias con colores rotativos al activarse */
.checkpill.on{background:rgba(129,140,248,.16);}
.checkpill.on:nth-child(6n+1){background:rgba(251,113,133,.17);} .checkpill.on:nth-child(6n+1) .box{background:var(--g-fr);}
.checkpill.on:nth-child(6n+2){background:rgba(34,211,238,.15);}  .checkpill.on:nth-child(6n+2) .box{background:var(--g-td);}
.checkpill.on:nth-child(6n+3){background:rgba(251,191,36,.18);}  .checkpill.on:nth-child(6n+3) .box{background:var(--g-ki);}
.checkpill.on:nth-child(6n+4){background:rgba(167,139,250,.18);} .checkpill.on:nth-child(6n+4) .box{background:var(--g-im);}
.checkpill.on:nth-child(6n+5){background:rgba(52,211,153,.17);}  .checkpill.on:nth-child(6n+5) .box{background:linear-gradient(135deg,#34d399,#10b981);}
.checkpill.on:nth-child(6n){background:rgba(244,114,182,.16);}   .checkpill.on:nth-child(6n) .box{background:linear-gradient(135deg,#f472b6,#c084fc);}
/* steppers y botones auxiliares con tinte */
.stepbtn{background:rgba(129,140,248,.14);border-color:rgba(129,140,248,.35);}
/* puntos de color en listas de modos */
.dot{display:inline-block;width:12px;height:12px;border-radius:4px;margin-right:9px;vertical-align:-1px;background:var(--g-main);}

/* ═══════════════════════════════════════════════════════
   FRENESÍ — warm red-orange, bold, urgent energy
   ═══════════════════════════════════════════════════════ */
#scr-fr-setup, #scr-fr-play, #scr-fr-boom, #scr-fr-score{
  --game-a:#ff4d6d; --game-b:#ff8c42; --game-bg:linear-gradient(160deg,rgba(255,77,109,.13),rgba(255,140,66,.09));
}
#scr-fr-setup .app-inner, #scr-fr-play .app-inner,
#scr-fr-boom .app-inner, #scr-fr-score .app-inner{ background:var(--game-bg); }
#scr-fr-setup::before, #scr-fr-play::before, #scr-fr-boom::before, #scr-fr-score::before{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:-1;
  background:radial-gradient(ellipse 80% 60% at 50% -10%, rgba(255,77,109,.22), transparent);
}
#scr-fr-play .glass{ background:linear-gradient(135deg,rgba(255,77,109,.22),rgba(255,140,66,.15)); border-color:rgba(255,100,80,.35); }
#scr-fr-play .bigword{ font-size:clamp(2.2rem,9vw,3.2rem); letter-spacing:-.03em; color:var(--text); }
.pulse{ background:linear-gradient(135deg,#ff4d6d,#ff8c42) !important; }
#scr-fr-boom .glass{ background:linear-gradient(135deg,rgba(255,40,60,.3),rgba(180,0,30,.2)); border-color:rgba(255,60,80,.4); }
#scr-fr-score .score.t0{ background:linear-gradient(135deg,#ff4d6d,#c9184a); }
#scr-fr-score .score.t1{ background:linear-gradient(135deg,#ff8c42,#e05c00); }
#scr-fr-setup .score.t0{ background:linear-gradient(135deg,#ff4d6d,#c9184a); }
#scr-fr-setup .score.t1{ background:linear-gradient(135deg,#ff8c42,#e05c00); }

/* ═══════════════════════════════════════════════════════
   IMPOSTOR — deep purple/indigo, mysterious, shadowy
   ═══════════════════════════════════════════════════════ */
#scr-roster, #scr-im-setup, #scr-im-reveal, #scr-im-discuss, #scr-im-result{
  --game-a:#7c3aed; --game-b:#4f46e5;
}
#scr-roster::before, #scr-im-setup::before, #scr-im-reveal::before,
#scr-im-discuss::before, #scr-im-result::before{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:-1;
  background:radial-gradient(ellipse 70% 70% at 80% 20%, rgba(124,58,237,.2), transparent),
             radial-gradient(ellipse 50% 50% at 10% 80%, rgba(79,70,229,.18), transparent);
}
#scr-im-reveal .role-card.hiddenface{
  background:linear-gradient(145deg,#4c1d95,#312e81) !important;
  border:none !important; min-height:180px;
}
#scr-im-discuss .timerbig{ background:var(--g-im); -webkit-background-clip:text; background-clip:text; color:transparent; font-size:3.2rem; }
#scr-im-result .glass:first-child{ background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(79,70,229,.12)); border-color:rgba(139,92,246,.35); }

/* ═══════════════════════════════════════════════════════
   REY DE COPAS — amber/gold, festive, classic card feel
   ═══════════════════════════════════════════════════════ */
#scr-ki-setup, #scr-ki-play, #scr-ki-custom{
  --game-a:#f59e0b; --game-b:#d97706;
}
#scr-ki-setup::before, #scr-ki-play::before, #scr-ki-custom::before{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:-1;
  background:radial-gradient(ellipse 90% 50% at 50% 0%, rgba(251,191,36,.2), transparent),
             radial-gradient(ellipse 40% 60% at 90% 90%, rgba(217,119,6,.18), transparent);
}
#scr-ki-play .rank{
  background:linear-gradient(145deg,rgba(254,243,199,.6),rgba(253,230,138,.3));
  border-color:rgba(217,119,6,.4); font-size:1.6rem; transition:all .15s;
}
html[data-theme="dark"] #scr-ki-play .rank{
  background:linear-gradient(145deg,rgba(120,53,15,.35),rgba(92,40,6,.2));
  border-color:rgba(251,191,36,.3);
}
#scr-ki-play .rank:hover{ transform:translateY(-4px) scale(1.06); box-shadow:0 8px 20px rgba(245,158,11,.35); }
.orank{ font-size:3rem; }
#ki-overlay .glass{ background:linear-gradient(145deg,rgba(254,243,199,.8),rgba(253,230,138,.5)); }
html[data-theme="dark"] #ki-overlay .glass{ background:linear-gradient(145deg,rgba(120,53,15,.6),rgba(92,40,6,.4)); }

/* ═══════════════════════════════════════════════════════
   VERDAD O RETO — electric teal/blue, bold choices
   ═══════════════════════════════════════════════════════ */
#scr-td-level, #scr-td-play, #scr-td-custom{
  --game-a:#06b6d4; --game-b:#3b82f6;
}
#scr-td-level::before, #scr-td-play::before, #scr-td-custom::before{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:-1;
  background:radial-gradient(ellipse 80% 60% at 20% 0%, rgba(6,182,212,.18), transparent),
             radial-gradient(ellipse 60% 80% at 80% 100%, rgba(59,130,246,.18), transparent);
}
/* Phase - player picker: big grid feel */
#td-phase-player .glass{ background:linear-gradient(135deg,rgba(6,182,212,.15),rgba(59,130,246,.1)); border-color:rgba(6,182,212,.3); }
.playerbtns .btn{
  background:linear-gradient(135deg,rgba(6,182,212,.15),rgba(59,130,246,.12));
  border-color:rgba(6,182,212,.35); font-size:1rem; padding:18px 10px; border-radius:20px;
  transition:all .15s ease;
}
.playerbtns .btn:hover{ background:linear-gradient(135deg,rgba(6,182,212,.3),rgba(59,130,246,.25)); transform:translateY(-3px); }
/* Phase - choice: giant buttons, dramatic */
#td-phase-choice .glass{ background:linear-gradient(135deg,rgba(6,182,212,.18),rgba(59,130,246,.12)); border-color:rgba(6,182,212,.35); padding:24px; }
#td-btn-verdad{ font-size:1.2rem; padding:22px; letter-spacing:.03em; }
#td-btn-reto{ font-size:1.2rem; padding:22px; letter-spacing:.03em; }
/* Phase - prompt: spotlight on the card */
#td-phase-prompt .glass{
  background:linear-gradient(145deg,rgba(6,182,212,.2),rgba(59,130,246,.15));
  border-color:rgba(6,182,212,.4); padding:28px 24px;
}
#td-phase-prompt .bigword{ font-size:clamp(1.3rem,4.5vw,1.7rem); min-height:auto; padding:16px 0; color:var(--text); }
.tdtag.v{ background:var(--g-td); font-size:.85rem; letter-spacing:.1em; }
.tdtag.r{ background:var(--g-fr); font-size:.85rem; letter-spacing:.1em; }

/* ═══════════════════════════════════════════════════════
   HOME — keep it neutral but slightly more vivid
   ═══════════════════════════════════════════════════════ */
#scr-home .game-card.fr{ border-left:4px solid #ff4d6d; }
#scr-home .game-card.im{ border-left:4px solid #7c3aed; }
#scr-home .game-card.ki{ border-left:4px solid #f59e0b; }
#scr-home .game-card.td{ border-left:4px solid #06b6d4; }
/* Animated gradient outline on hover */
#scr-home .game-card{ transition:transform .15s ease, box-shadow .15s ease; }
#scr-home .game-card:hover{ box-shadow:0 16px 40px rgba(0,0,0,.15), 0 0 0 2px rgba(129,140,248,.35); }

/* ═══════════════════════════════════════════════════════
   TYPOGRAPHY DIFFERENTIATION PER GAME
   ═══════════════════════════════════════════════════════ */
/* Frenesí: extra bold condensed feel */
#scr-fr-play .bigword{ font-weight:800; letter-spacing:-.04em; }
#scr-fr-setup .title, #scr-fr-play .title, #scr-fr-boom .title, #scr-fr-score .title{
  font-size:1.5rem; letter-spacing:-.03em;
}
/* Impostor: spaced, mysterious */
#scr-im-setup .title, #scr-im-reveal .title, #scr-im-discuss .title, #scr-im-result .title{
  letter-spacing:.04em; font-weight:700;
}
#scr-im-reveal .secretword{ font-size:2.2rem; letter-spacing:.06em; }
#scr-im-result .title{ font-size:1.4rem; letter-spacing:.06em; color:var(--text); }
/* Rey de Copas: regal, warm */
#scr-ki-play .rank{ font-weight:900; font-family:'Baloo 2',cursive; }
#ki-overlay .orank{ font-size:3.5rem; font-weight:900; }
#ki-overlay .title{ font-size:1.6rem; letter-spacing:.02em; }
/* Verdad o Reto: punchy, direct */
#td-current{ font-size:2rem !important; background:var(--g-td); -webkit-background-clip:text; background-clip:text; color:transparent; }


/* ── Impostor mode card ─────────────────────── */
.help-btn{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--stroke-soft);
  background:var(--chip);color:var(--text-soft);font-weight:700;cursor:pointer;font-size:.9rem;
  display:flex;align-items:center;justify-content:center;flex:none;}
.help-btn:hover{background:var(--g-im);color:#fff;border-color:transparent;}
#im-mode-desc{transition:opacity .2s;}
/* Free pick grid uses same playerbtns grid */
/* ── Discuss starter block ──────────────────── */
.starter-block{display:inline-block;padding:12px 24px;border-radius:20px;
  background:linear-gradient(135deg,rgba(124,58,237,.18),rgba(79,70,229,.12));
  border:1.5px solid rgba(139,92,246,.35);}
.starter-name{font-family:'Baloo 2',cursive;font-weight:800;font-size:1.9rem;
  background:var(--g-im);-webkit-background-clip:text;background-clip:text;color:transparent;
  letter-spacing:-.02em;line-height:1.1;}
/* ── Ki profile list ────────────────────────── */
.profile-row{display:flex;align-items:center;gap:10px;}
.profile-row .btn{flex:1;text-align:left;padding:13px 16px;}
.profile-row .sel-dot{width:10px;height:10px;border-radius:50%;background:var(--g-ki);
  display:none;flex:none;}
.profile-row.active .sel-dot{display:block;}
.profile-row.active .btn{border-color:rgba(245,158,11,.6);background:rgba(251,191,36,.15);}
/* ── FR custom category pill arrow ─────────── */
.cat-pill-row{display:flex;align-items:center;gap:8px;}
.cat-pill-row .checkpill{flex:1;}
.cat-open-btn{width:36px;height:36px;border-radius:12px;border:1px solid var(--stroke-soft);
  background:var(--chip);color:var(--text-soft);cursor:pointer;display:flex;align-items:center;
  justify-content:center;flex:none;font-size:1.1rem;transition:all .15s;}
.cat-open-btn:hover{background:var(--g-fr);color:#fff;border-color:transparent;}
/* ── Help / mode overlay ────────────────────── */
#im-help-overlay{position:fixed;inset:0;background:rgba(10,12,30,.55);
  backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;
  padding:24px;z-index:70;}
#im-help-overlay.open{display:flex;}
#im-help-overlay .glass{max-width:400px;width:100%;}
/* ── FR custom words panel ──────────────────── */
.fr-custom-panel{display:none;margin-top:10px;padding:12px;background:rgba(255,77,109,.06);
  border-radius:16px;border:1px solid rgba(255,77,109,.2);}
.fr-custom-panel.open{display:block;}
.fr-profile-sel{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px;}
.fr-profile-sel .fpill{font-family:'Baloo 2',cursive;font-weight:700;font-size:.82rem;
  border:1.5px solid var(--stroke-soft);border-radius:999px;padding:6px 14px;
  background:var(--chip);cursor:pointer;transition:all .15s;}
.fr-profile-sel .fpill.on{background:var(--g-fr);color:#fff;border-color:transparent;}
.fr-profile-input-row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;}

</style>
