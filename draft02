function kiShow(r){
  let title, desc;
  if(ki.mode==='custom'){
    title = 'Carta '+r;
    const prof = kiActiveProfile!==null && kiProfiles[kiActiveProfile];
    desc = (prof && prof.rules[r] && prof.rules[r].trim()) || (ki.custom[r]||'').trim() || 'Sin regla asignada: el grupo inventa una en el momento.';
  }else{
    title = KINGS[r][ki.mode].t;
    desc = KINGS[r][ki.mode].d;
  }
  $('ki-o-rank').textContent = r;
  $('ki-o-title').textContent = title;
  $('ki-o-desc').textContent = desc;
  ki.seen++; $('ki-count').textContent = Math.min(ki.seen,52);
  softClick();
  $('ki-overlay').classList.add('open');
}
function kiClose(){ $('ki-overlay').classList.remove('open'); }
function kiResetCount(){ ki.seen=0; $('ki-count').textContent=0; }
$('ki-overlay').addEventListener('click',e=>{ if(e.target.id==='ki-overlay') kiClose(); });

/* =================== VERDAD O RETO =================== */
const td = {mode:'divertido', used:{verdad:[],reto:[]}, lastType:'verdad', current:null};
const tdCustom = {verdad:[], reto:[]};

function tdStart(mode){
  if(mode==='custom' && (tdCustom.verdad.length===0 || tdCustom.reto.length===0)){
    $('td-custom-err').classList.add('show');
    return;
  }
  $('td-custom-err').classList.remove('show');
  td.mode = mode;
  td.used = {verdad:[],reto:[]};
  $('td-mode-tag').textContent = TD_MODE_NAMES[mode];
  tdBackToPlayers();
  show('scr-td-play');
}
function tdOpenCustom(){
  $('td-custom-err').classList.remove('show');
  renderTdCustom();
  show('scr-td-custom');
}
function tdCustomAdd(type){
  const inp = $(type==='verdad' ? 'td-new-v' : 'td-new-r');
  const v = inp.value.trim();
  if(!v) return;
  tdCustom[type].push(v);
  inp.value=''; inp.focus();
  renderTdCustom(); softClick();
}
function renderTdCustom(){
  [['verdad','td-custom-v'],['reto','td-custom-r']].forEach(pair=>{
    const type=pair[0], box=$(pair[1]); box.innerHTML='';
    if(tdCustom[type].length===0){
      const p=document.createElement('p'); p.className='hint'; p.style.margin='0';
      p.textContent='Aún no hay cartas aquí.';
      box.appendChild(p); return;
    }
    tdCustom[type].forEach((c,i)=>{
      const row=document.createElement('div'); row.className='customitem';
      const txt=document.createElement('span'); txt.textContent=c;
      const del=miniBtn('M6 6l12 12M18 6L6 18',()=>{tdCustom[type].splice(i,1);renderTdCustom();},false,'Quitar'); del.classList.add('del');
      row.append(txt,del); box.appendChild(row);
    });
  });
}
['td-new-v','td-new-r'].forEach(id=>{
  $(id).addEventListener('keydown',e=>{ if(e.key==='Enter') tdCustomAdd(id==='td-new-v'?'verdad':'reto'); });
});
function tdPhase(p){
  $('td-phase-player').style.display = p==='player'?'flex':'none';
  $('td-phase-choice').style.display = p==='choice'?'flex':'none';
  $('td-phase-prompt').style.display = p==='prompt'?'flex':'none';
}
function tdBackToPlayers(){
  const box=$('td-players'); box.innerHTML='';
  players.forEach(p=>{
    const b=document.createElement('button'); b.className='btn';
    b.innerHTML = avSVG(p.av,'sm') + '<span>'+esc(p.name)+'</span>';
    b.onclick=()=>{
      td.current=p;
      $('td-current').textContent=p.name;
      $('td-choice-av').innerHTML=avSVG(p.av,'md');
      tdPhase('choice'); softClick();
    };
    box.appendChild(b);
  });
  tdPhase('player');
}
function tdPool(type){ return td.mode==='custom' ? tdCustom[type] : TOD[td.mode][type]; }
function tdDraw(type){
  const pool = tdPool(type);
  let avail = pool.map((_,i)=>i).filter(i=>!td.used[type].includes(i));
  if(avail.length===0){ td.used[type]=[]; avail = pool.map((_,i)=>i); }
  const i = rand(avail); td.used[type].push(i);
  return pool[i];
}
function tdPick(type){
  td.lastType = type;
  $('td-type-tag').textContent = type==='verdad' ? 'Verdad' : 'Reto';
  $('td-type-tag').className = 'tdtag ' + (type==='verdad'?'v':'r');
  $('td-for').textContent = 'para '+td.current.name;
  $('td-prompt-av').innerHTML = avSVG(td.current.av,'md');
  $('td-prompt').textContent = tdDraw(type);
  tdPhase('prompt');
  softClick();
}
function tdReroll(){ $('td-prompt').textContent = tdDraw(td.lastType); softClick(); }
function tdDone(){ okSound(); tdBackToPlayers(); }

/* init */
renderHomeChips();
