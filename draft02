function kiSaveProfilesToStorage(){ try{ localStorage.setItem('ki_profiles', JSON.stringify(kiProfiles)); }catch(e){} }

function kiOpenCustom(){
  kiRenderProfiles();
  $('ki-rule-editor').style.display = 'none';
  $('ki-play-custom').style.display = 'none';
