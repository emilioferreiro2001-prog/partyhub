/* ---------- sonidos (sintetizador suave) ---------- */
let SND = true, AC = null;
function ctx(){ AC = AC || new (window.AudioContext||window.webkitAudioContext)(); if(AC.state==='suspended') AC.resume(); return AC; }
function tone(freq, dur, vol, type, glideTo){
  if(!SND) return;
  try{
    const ac = ctx(), o = ac.createOscillator(), g = ac.createGain();
    o.type = type||'sine'; o.frequency.setValueAtTime(freq, ac.currentTime);
    if(glideTo) o.frequency.exponentialRampToValueAtTime(glideTo, ac.currentTime+dur);
    g.gain.setValueAtTime(vol, ac.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0008, ac.currentTime+dur);
    o.connect(g); g.connect(ac.destination);
    o.start(); o.stop(ac.currentTime+dur+0.03);
  }catch(e){}
}
