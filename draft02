function imSetMode(mode){
  im.mode = mode;
  $('im-seg-ordered').classList.toggle('on', mode==='ordered');
  $('im-seg-free').classList.toggle('on', mode==='free');
  $('im-mode-desc').textContent = mode==='ordered'
    ? 'Cada jugador recibe el teléfono en el orden de la lista. Pásalo de uno en uno.'
    : 'La pantalla muestra todos los nombres. Cada quien toca el suyo para ver su papel.';
  softClick();
}
function imModeHelp(){ document.getElementById('im-help-overlay').classList.add('open'); }

function imBuildFreeGrid(){
  const grid = $('im-free-grid');
  grid.innerHTML = '';
  players.forEach((p,i) => {
    const done = !!im.freeRevealed[i];
    const pl = typeof p === 'object' ? p : {name:p, av:null};
    const b = document.createElement('button');
    b.className = 'btn' + (done ? ' quiet' : '');
    b.style.cssText = 'display:flex;align-items:center;gap:10px;padding:14px 16px;';
    b.innerHTML = (pl.av!==null ? `<svg class="av av-sm"><use href="#av${pl.av}"/></svg>` : '') +
                  `<span>${esc(pl.name)}</span>` + (done ? ' <span style="margin-left:auto;opacity:.5;font-size:.8rem">visto</span>' : '');
    b.onclick = () => { imFreeOpen(i); };
    b.disabled = done;
    grid.appendChild(b);
  });
  const allDone = players.every((_,i) => im.freeRevealed[i]);
  const hint = $('im-free-card');
  if(allDone){ imFinishReveal(); }
}
function imFreeOpen(idx){
  im.current = idx;
  const pl = typeof players[idx]==='object' ? players[idx] : {name:players[idx], av:null};
  $('im-free-card').style.display = 'block';
  $('im-free-card').classList.add('hiddenface');
  $('im-free-inner').innerHTML = `<div class="secretword" style="font-size:1.3rem">${esc(pl.name)}, toca para ver tu papel</div>`;
  $('im-free-next').style.display = 'block';
  $('im-free-next').disabled = true;
  $('im-free-next').style.opacity = '.4';
  softClick();
}
function imFreeFlip(){
  const idx = im.current;
  if(im.freeRevealed[idx]) return;
  $('im-free-card').classList.remove('hiddenface');
  const pl = typeof players[idx]==='object' ? players[idx] : {name:players[idx], av:null};
  if(im.roles[idx]==='impostor'){
    const hint = $('im-hint').checked
      ? `<p class="hint">Categoría: <b>${IM_CATS[im.catUsed].name}</b>.</p>`
      : '<p class="hint">Sin pistas. Suerte.</p>';
    $('im-free-inner').innerHTML = `<div class="imp-label">Eres el impostor</div>${hint}`;
  } else {
    $('im-free-inner').innerHTML = `<p class="hint" style="margin:0">La palabra secreta es</p><div class="secretword">${esc(im.word)}</div>`;
  }
  $('im-free-next').disabled = false;
  $('im-free-next').style.opacity = '1';
  softClick();
}
function imFreeClose(){
  im.freeRevealed[im.current] = true;
  $('im-free-card').style.display = 'none';
  $('im-free-next').style.display = 'none';
  imBuildFreeGrid();
  softClick();
}
function imFinishReveal(){
  const startIdx = Math.floor(Math.random()*players.length);
  const pl = typeof players[startIdx]==='object' ? players[startIdx] : {name:players[startIdx], av:null};
  $('im-starter-name').textContent = pl.name;
  if(pl.av!==null) $('im-starter-av').innerHTML = avSVG(pl.av,'md');
  imStartDiscussTimer();
  show('scr-im-discuss');
}
function imClampImpostors(){
  const max = Math.max(1, Math.min(3, players.length-2));
  im.impostors = Math.min(im.impostors, max);
  $('im-icount').textContent = im.impostors;
}
function imAdj(d){
  const max = Math.max(1, Math.min(3, players.length-2));
  im.impostors = Math.min(max, Math.max(1, im.impostors+d));
  $('im-icount').textContent = im.impostors;
  softClick();
}
function imStart(){
  const activeCats = Object.keys(IM_CATS).filter(k=>im.cats[k]);
  const bad = activeCats.length===0;
  $('im-cat-err').classList.toggle('show', bad);
  if(bad){ show('scr-im-setup'); return; }
  im.catUsed = rand(activeCats);
  im.word = rand(IM_CATS[im.catUsed].words);
  im.roles = Array(players.length).fill('civil');
  shuffle([...Array(players.length).keys()]).slice(0, im.impostors).forEach(i=>im.roles[i]='impostor');
  im.current = 0;
  im.freeRevealed = {};
  if(im.mode === 'free'){
    imBuildFreeGrid();
    $('im-reveal-ordered').style.display = 'none';
    $('im-reveal-free').style.display    = 'flex';
  } else {
    $('im-reveal-ordered').style.display = 'flex';
    $('im-reveal-free').style.display    = 'none';
    imPaintTurn();
  }
  show('scr-im-reveal');
}
function imPaintTurn(){
  im.revealed = false;
  const pl = players[im.current];
  $('im-turn').textContent = 'Turno de '+pl.name;
  $('im-turn-av').innerHTML = avSVG(pl.av,'md');
  const c=$('im-card'); c.classList.add('hiddenface');
  $('im-card-inner').innerHTML = '<div class="secretword" style="font-size:1.3rem">'+esc(pl.name)+', toca para ver tu papel</div>';
  $('im-next').disabled = true;
}
function imFlip(){
  if(im.revealed) return;
  im.revealed = true;
  $('im-card').classList.remove('hiddenface');
  if(im.roles[im.current]==='impostor'){
    const hint = $('im-hint').checked
      ? '<p class="hint">Pista: la categoría es <b>'+IM_CATS[im.catUsed].name+'</b>.</p>'
      : '<p class="hint">Sin pistas. Suerte.</p>';
    $('im-card-inner').innerHTML = '<div class="imp-label">Eres el impostor</div>'+hint+'<p class="hint">Finge que conoces la palabra.</p>';
  }else{
    $('im-card-inner').innerHTML = '<p class="hint" style="margin:0">La palabra secreta es</p><div class="secretword">'+esc(im.word)+'</div>';
  }
  $('im-next').disabled = false;
  softClick();
}
function imNextPlayer(){
  im.current++;
  if(im.current >= players.length){
    const startIdx = Math.floor(Math.random()*players.length);
    const pl = typeof players[startIdx]==='object' ? players[startIdx] : {name:players[startIdx], av:null};
    $('im-starter-name').textContent = pl.name;
    if(pl.av!==null) $('im-starter-av').innerHTML = avSVG(pl.av,'md');
    imStartDiscussTimer();
    show('scr-im-discuss');
  }else imPaintTurn();
}
function imStartDiscussTimer(){
  clearInterval(im.timer);
  let left = 180;
  const paint = ()=>{ $('im-timer').textContent = Math.floor(left/60)+':'+String(left%60).padStart(2,'0'); };
  paint();
  im.timer = setInterval(()=>{
    left--;
    if(left<=0){ clearInterval(im.timer); $('im-timer').textContent='0:00'; defeatSound(); return; }
    if(left<=10) tone(760,0.05,0.04);
    paint();
  },1000);
}
function imReveal(){
  clearInterval(im.timer);
  const imps = players.filter((_,i)=>im.roles[i]==='impostor');
  $('im-who').textContent = (imps.length>1?'Los impostores eran ':'El impostor era ')+imps.map(p=>p.name).join(' y ');
  $('im-result-av').innerHTML = imps.map(p=>avSVG(p.av,'md')).join('');
  $('im-word-out').innerHTML = 'La palabra secreta era <b>'+esc(im.word)+'</b> ('+IM_CATS[im.catUsed].name+'). Si lo atraparon, gana el grupo; si no, gana el impostor.';
  okSound();
  show('scr-im-result');
}

