function frRenderCustomWords(){
  const prof = frCustomProfiles[frActiveCustomProfile];
  const hint=$('fr-cp-hint'); const box=$('fr-cp-words'); if(!box) return;
  hint.textContent=prof.name+' · '+prof.words.length+'/10 palabras';
  box.innerHTML='';
  prof.words.forEach((w,i)=>{
    const row=document.createElement('div'); row.style.cssText='display:flex;gap:6px;width:100%;margin-bottom:6px;';
    const inp=document.createElement('input'); inp.type='text'; inp.value=w; inp.style.flex='1';
    inp.addEventListener('input',()=>{ prof.words[i]=inp.value; frSaveCustom(); });
    const del=document.createElement('button'); del.className='mini del'; del.innerHTML='<svg class="icon" style="width:14px;height:14px" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>';
    del.onclick=()=>{ prof.words.splice(i,1); frSaveCustom(); frRenderCustomWords(); };
    row.append(inp,del); box.appendChild(row);
  });
  if(prof.words.length<10){
    const addRow=document.createElement('div'); addRow.style.cssText='display:flex;gap:6px;width:100%;margin-top:4px;';
    const newInp=document.createElement('input'); newInp.type='text'; newInp.placeholder='Agregar palabra o frase'; newInp.style.flex='1';
    const addBtn=document.createElement('button'); addBtn.className='btn'; addBtn.style.padding='10px 14px'; addBtn.textContent='+';
    addBtn.onclick=()=>{ if(newInp.value.trim()&&prof.words.length<10){ prof.words.push(newInp.value.trim()); frSaveCustom(); frRenderCustomWords(); }};
    newInp.addEventListener('keydown',e=>{ if(e.key==='Enter') addBtn.click(); });
    addRow.append(newInp,addBtn); box.appendChild(addRow);
    // Profile rename
    const rnRow=document.createElement('div'); rnRow.style.cssText='display:flex;gap:6px;width:100%;margin-top:8px;align-items:center;';
    const rnInp=document.createElement('input'); rnInp.type='text'; rnInp.value=prof.name; rnInp.placeholder='Nombre del perfil'; rnInp.style.flex='1';
    rnInp.addEventListener('input',()=>{ prof.name=rnInp.value; frSaveCustom(); frRenderCustomProfiles(); });
    const delProf=document.createElement('button'); delProf.className='btn danger'; delProf.style.padding='10px 14px'; delProf.textContent='Borrar perfil';
    delProf.onclick=()=>{ if(frCustomProfiles.length>1){ frCustomProfiles.splice(frActiveCustomProfile,1); frActiveCustomProfile=0; frSaveCustom(); frRenderCustomProfiles(); }};
    rnRow.append(rnInp,delProf); box.appendChild(rnRow);
  }
}
