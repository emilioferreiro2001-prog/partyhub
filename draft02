function frAdjTarget(d){ fr.target=Math.min(15,Math.max(1,fr.target+d)); $('fr-target').textContent=fr.target; softClick(); }
function frTeamNames(){
  fr.names[0] = $('fr-team0').value.trim() || 'Equipo 1';
  fr.names[1] = $('fr-team1').value.trim() || 'Equipo 2';
  ['','b'].forEach(x=>{ $('fr-n0'+x).textContent=fr.names[0]; $('fr-n1'+x).textContent=fr.names[1]; });
  $('fr-blame0').textContent = fr.names[0];
  $('fr-blame1').textContent = fr.names[1];
}
function frPaintScores(){
  ['','b'].forEach(x=>{ $('fr-s0'+x).textContent=fr.scores[0]; $('fr-s1'+x).textContent=fr.scores[1]; });
}
function frStart(){
  frTeamNames();
  const pool = checkedWords(FR_CATS, fr.cats);
  const bad = pool.length===0;
  $('fr-cat-err').classList.toggle('show', bad);
  if(bad){ show('scr-fr-setup'); return; }
  if(!fr.fullDeck || fr.fullDeck.join() !== pool.join()){
    fr.fullDeck = shuffle(pool);
    fr.deckPos  = 0;
  }
  frNextWord();
  show('scr-fr-play');

  fr.durTotal = 45000 + Math.random()*30000;   /* 45 a 75 s, secreto */
  fr.endAt = Date.now() + fr.durTotal;
  fr.paused = false;
  $('fr-pause').textContent = 'Pausar';
  $('fr-adv').disabled = false;
  $('fr-pulse').classList.remove('paused');
  clearTimeout(fr.endTimer); clearTimeout(fr.tickTimer);
  frLoop();
  fr.endTimer = setTimeout(frBoom, fr.durTotal);
}
function frLoop(){
  if(fr.paused) return;
  const left = fr.endAt - Date.now();
  if(left<=0) return;
  const f = Math.max(0, left/fr.durTotal);          /* 1 -> 0 */
  /* Marimba-like: triangle wave, musical pitch ladder, gentle start loud finish */
  const urgency = Math.pow(1-f, 2.0);
  const notes = [261,294,330,370,415,466,523,587,659,740];
  const noteIdx = Math.min(notes.length-1, Math.floor(urgency*notes.length));
  tone(notes[noteIdx], 0.07+0.05*urgency, 0.03+0.22*urgency, 'triangle');
  $('fr-pulse').style.setProperty('--beat', (0.35+0.85*f)+'s');
  fr.tickTimer = setTimeout(frLoop, 180+820*f);      /* se acelera agresivamente */
}
function frPauseToggle(){
  if(!fr.paused){
    fr.paused = true;
    fr.leftMs = Math.max(0, fr.endAt - Date.now());
    clearTimeout(fr.endTimer); clearTimeout(fr.tickTimer);
    fr.savedWord = $('fr-word').textContent;
    $('fr-word').textContent = 'Juego en pausa';
    $('fr-pause').textContent = 'Reanudar';
    $('fr-adv').disabled = true;
    $('fr-pulse').classList.add('paused');
  }else{
    fr.paused = false;
    fr.endAt = Date.now() + fr.leftMs;
    $('fr-word').textContent = fr.savedWord;
    $('fr-pause').textContent = 'Pausar';
    $('fr-adv').disabled = false;
    $('fr-pulse').classList.remove('paused');
    fr.endTimer = setTimeout(frBoom, fr.leftMs);
    frLoop();
  }
  softClick();
}
function frNextWord(){
  if(!fr.fullDeck) fr.fullDeck = shuffle(checkedWords(FR_CATS, fr.cats));
  if(fr.deckPos >= fr.fullDeck.length){ fr.fullDeck = shuffle(checkedWords(FR_CATS, fr.cats)); fr.deckPos=0; }
  $('fr-word').textContent = fr.fullDeck[fr.deckPos++];
}
function frNext(){ if(fr.paused) return; softClick(); frNextWord(); }
function frStopTimers(){ clearTimeout(fr.endTimer); clearTimeout(fr.tickTimer); }
function frBoom(){
  frStopTimers();
  defeatSound();
  if(navigator.vibrate) navigator.vibrate([220,90,320]);
  const fl=$('flash'); fl.classList.add('on');
  setTimeout(()=>fl.classList.remove('on'), 1500);
  show('scr-fr-boom');
}
function frQuit(){ frStopTimers(); show('scr-fr-setup'); }
function frBlame(loser){
  const w = loser===0 ? 1 : 0;
  fr.scores[w]++; frPaintScores();
  if(fr.scores[w] >= fr.target){
    $('fr-win-doodle').style.display='flex';
    $('fr-round-msg').textContent = fr.names[w]+' gana el juego';
    $('fr-round-sub').textContent = 'Marcador final '+fr.scores[0]+' a '+fr.scores[1]+', jugando a '+fr.target+' puntos.';
    $('fr-next-btn').textContent = 'Jugar de nuevo';
    fr.scores=[0,0];
    victoryTune(); confetti(40);
  }else{
    $('fr-win-doodle').style.display='none';
    $('fr-round-msg').textContent = 'Punto para '+fr.names[w];
    $('fr-round-sub').textContent = 'Van '+fr.scores[0]+' a '+fr.scores[1]+'. Gana el primero en llegar a '+fr.target+'.';
    $('fr-next-btn').textContent = 'Siguiente ronda';
    okSound();
  }
  show('scr-fr-score');
}
