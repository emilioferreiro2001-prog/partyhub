function kiNewProfile(){
  const defaultRules = {};
  KI_RANKS.forEach(r => defaultRules[r] = KINGS[r].divertida.d);
  kiProfiles.push({ name: 'Perfil '+(kiProfiles.length+1), rules: defaultRules });
  kiSaveProfilesToStorage();
  kiActiveProfile = kiProfiles.length-1;
  kiEditProfile(kiActiveProfile);
  kiRenderProfiles();
}
function kiEditProfile(idx){
  const prof = kiProfiles[idx];
  $('ki-profile-name').value = prof.name||'';
  $('ki-profile-name').oninput = ()=>{ kiProfiles[idx].name=$('ki-profile-name').value; kiRenderProfiles(); };
  const box = $('ki-custom-list'); box.innerHTML='';
  KI_RANKS.forEach(r=>{
    const row=document.createElement('div'); row.className='customrow';
    const rk=document.createElement('div'); rk.className='rk'; rk.textContent=r;
    const inp=document.createElement('input'); inp.type='text'; inp.value=prof.rules[r]||'';
    inp.placeholder='Regla para '+r;
    inp.addEventListener('input',()=>{ kiProfiles[idx].rules[r]=inp.value; });
    row.append(rk,inp); box.appendChild(row);
  });
  $('ki-rule-editor').style.display='block';
  $('ki-play-custom').style.display='block';
  kiActiveProfile=idx;
}
function kiSaveProfile(){
  kiSaveProfilesToStorage();
  okSound();
  const btn=$('ki-rule-editor').querySelector('button.btn.big');
  if(btn){ const old=btn.textContent; btn.textContent='Guardado'; setTimeout(()=>btn.textContent=old,1200); }
