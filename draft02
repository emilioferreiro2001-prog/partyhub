function checkedWords(cats, state){
  let w=[]; Object.keys(cats).forEach(k=>{ if(state[k]) w=w.concat(cats[k].words); });
  if(fr.useCustomCat && frCustomProfiles[frActiveCustomProfile]){
    const cw = frCustomProfiles[frActiveCustomProfile].words.filter(Boolean);
    w = w.concat(cw);
  }
  return w;
}

