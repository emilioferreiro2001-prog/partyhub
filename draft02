<script>
/* Registro de service worker: solo aplica cuando la app se sirve por http(s),
   por ejemplo dentro del APK o en un hosting. Abierto como archivo, se ignora. */
if('serviceWorker' in navigator && location.protocol.indexOf('http')===0){
  window.addEventListener('load', function(){
    navigator.serviceWorker.register('sw.js').catch(function(){});
  });
}
</script>
