function kiRenderProfiles(){
  const list = $('ki-profile-list');
  list.innerHTML = '';
  if(kiProfiles.length===0){
    const p = document.createElement('p');
    p.className = 'hint';
    p.textContent = 'Aún no tienes perfiles. Crea uno con el botón + Nuevo.';
    list.appendChild(p);
    return;
  }
  kiProfiles.forEach((prof,i)=>{
    const row = document.createElement('div');
    row.className = 'profile-row' + (kiActiveProfile===i?' active':'');
