function kiDeleteProfile(){
  if(kiActiveProfile===null) return;
  kiProfiles.splice(kiActiveProfile,1);
  kiActiveProfile=null;
  kiSaveProfilesToStorage();
  $('ki-rule-editor').style.display='none';
  $('ki-play-custom').style.display='none';
  kiRenderProfiles();
  softClick();
}
