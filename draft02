function avSVG(n, cls){
  return '<svg class="av'+(cls?' '+cls:'')+'" role="img" aria-label="'+AV_NAMES[n]+'"><title>'+AV_NAMES[n]+'</title><use href="#av'+n+'"/></svg>';
}
let players = [], avBag = [];
function nextAvatar(){
  if(avBag.length===0) avBag = shuffle([...Array(AV_COUNT).keys()]);
  return avBag.pop();
}
function addPlayer(name){
  name = name.trim();
  if(!name) return false;
  players.push({name:name, av:nextAvatar()});
  renderHomeChips(); renderRoster();
  return true;
}
function addPlayerFromHome(){
  if(addPlayer($('home-name').value)) $('home-name').value='';
  $('home-name').focus();
}
function removePlayer(i){ players.splice(i,1); renderHomeChips(); renderRoster(); }
function movePlayer(i,d){
  const j=i+d; if(j<0||j>=players.length) return;
  [players[i],players[j]]=[players[j],players[i]];
  renderRoster(); renderHomeChips();
}
function renderHomeChips(){
  const box=$('home-chips'); box.innerHTML='';
  players.forEach((p,i)=>{
    const c=document.createElement('span'); c.className='chip';
    c.innerHTML = avSVG(p.av,'sm') + '<span>'+esc(p.name)+'</span>';
    const x=document.createElement('button'); x.setAttribute('aria-label','Quitar '+p.name);
    x.innerHTML='<svg viewBox="0 0 24 24" style="width:11px;height:11px;stroke:currentColor;stroke-width:2.6;fill:none;stroke-linecap:round"><path d="M6 6l12 12M18 6L6 18"/></svg>';
